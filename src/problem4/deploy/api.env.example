# Install OUTSIDE the repo as /etc/ship-api.env, root:root 0600.
# POSTGRES_PASSWORD is bootstrap-only and must equal DB_PASSWORD.
# Compose v2.30+ raw format: values are literal, including $ and quotes.
# Do not quote values or source this file as shell code.
POSTGRES_PASSWORD=replace-with-a-strong-secret
DB_PASSWORD=replace-with-a-strong-secret
DB_HOST=postgres
REDIS_HOST=redis
CORS_ORIGIN=https://app.example.com
