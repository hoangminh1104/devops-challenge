# Install as /etc/ship-api-deploy.env, root:root 0600 in a root-owned /etc.
# Trusted Bash code sourced with set -a; never allow application/release writers.
# Defaults match deploy-backend.sh and production Compose.
APP_ROOT=/opt/ship-api
API_PROJECT=ship-api
API_ENV_FILE=/etc/ship-api.env
DATA_NETWORK=ship-api-data
API_BIND=127.0.0.1
API_PORT=3000
