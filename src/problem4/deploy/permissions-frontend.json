{
  "Version": "2012-10-17",
  "Statement": [
    { "Effect": "Allow", "Action": ["s3:PutObject", "s3:GetObject"], "Resource": "arn:aws:s3:::ARTIFACT_BUCKET/frontend/*" },
    { "Effect": "Allow", "Action": "s3:ListBucket", "Resource": "arn:aws:s3:::ARTIFACT_BUCKET", "Condition": { "StringLike": { "s3:prefix": "frontend/*" } } },
    { "Effect": "Allow", "Action": "s3:PutObject", "Resource": ["arn:aws:s3:::SITE_BUCKET/assets/*", "arn:aws:s3:::SITE_BUCKET/index.html"] },
    { "Effect": "Allow", "Action": ["cloudfront:CreateInvalidation", "cloudfront:GetInvalidation"], "Resource": "arn:aws:cloudfront::ACCOUNT_ID:distribution/DISTRIBUTION_ID" }
  ]
}
