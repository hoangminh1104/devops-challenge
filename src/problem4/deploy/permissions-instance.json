{
  "Version": "2012-10-17",
  "Statement": [
    { "Effect": "Allow", "Action": "s3:GetObject", "Resource": "arn:aws:s3:::ARTIFACT_BUCKET/backend/*" },
    { "Effect": "Allow", "Action": "s3:ListBucket", "Resource": "arn:aws:s3:::ARTIFACT_BUCKET", "Condition": { "StringLike": { "s3:prefix": "backend/*" } } }
  ]
}
